{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    // The kit dirs hold harvested third-party components (never hand-edited;
    // see .agents/skills/create-kit). Flags that only enforce style on
    // upstream code are off here; `strict` keeps the real checks on.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"],
      "*": ["vendor/.extracted/node_modules/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "kit/**/*.ts",
    "kit/**/*.tsx",
    "functions/**/*.ts",
    "cssmod.d.ts"
  ],
  "exclude": ["vendor", ".cache", ".harness", "scripts/glue"]
}
