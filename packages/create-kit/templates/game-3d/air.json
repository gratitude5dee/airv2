{
  "schema": "air.app.v1",
  "appname": "game-3d",
  "name": "Orbit",
  "description": "A tap-timing game around a spinning cube; a still poster under lite and reduced motion.",
  "lane": "vibe",
  "entry": "src/main.tsx",
  "theme": "atmosphere",
  "surface": { "lite": false, "expanded": true },
  "kit": {
    "components": ["air", "fancy/scramble-in", "fancy/basic-number-ticker"]
  },
  "actions": ["start", "tap"],
  "guestActions": ["start", "tap"],
  "functions": null,
  "tests": [
    { "id": "title-visible", "see": "Orbit", "locked": true },
    { "id": "start-runs", "tap": "[data-test=start]", "wait": 400, "changed": "[data-test=status]", "locked": true },
    { "id": "still-frame", "see": "Still frame" }
  ]
}
