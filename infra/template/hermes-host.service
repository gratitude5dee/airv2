# MANDATORY. Snapshots do not capture open ports; the hosted routes must be
# re-registered on every resume. URLs and tokens are stable and sticky across
# re-hosts, so this is idempotent.
[Unit]
Description=Re-register Box hosted routes for 8642 and 9119 on every boot/resume
After=hermes-gateway.service hermes-dashboard.service
Wants=hermes-gateway.service hermes-dashboard.service
# Only ascii.dev Boxes carry the host CLI. On other providers (Tenki) the
# control plane publishes ports itself, so this unit is skipped — a Condition,
# not an Assert, so `systemctl start/restart hermes-host` still exits 0 there.
ConditionPathExists=/home/user/.ascii/host

[Service]
Type=oneshot
User=user
# The Box host CLI needs the ASCII_* env exported in ~/.bashrc (which guards
# against non-interactive sourcing), and /usr/bin/host (the DNS tool) shadows
# it in systemd's default PATH — hence the eval and the absolute path.
# Retry loop: right after a fork/resume the box agent token can briefly be
# stale (API 401 agent_revoked) until the platform rotates it.
ExecStart=/bin/bash -c 'eval "$(grep "^export ASCII_" /home/user/.bashrc)"; for i in $(seq 1 36); do /home/user/.ascii/host 8642 --private && /home/user/.ascii/host 9119 --private && exit 0; sleep 10; eval "$(grep "^export ASCII_" /home/user/.bashrc)"; done; exit 1'
TimeoutStartSec=420
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
