#!/usr/bin/env bash
# air-create — Vibe + Drop CLI for the create-miniapp skill (V11 §8, §9.5,
# §11; V12 §8.3, §8.4, §11.1; V13 §8 — skill version 5).
#
#   air-create new <appname> [--lane vibe|drop|import] [--title <t>]
#   air-create plan <appname> [--deliver] [--answers <file>]
#   air-create go <appname> [--change]            # V13: starts the job; the
#                                               #   reply + card print; turn ends
#   air-create compile <appname>                  # V13: syntax+lint pass,
#                                               #   ≤5 per turn server-side
#   air-create confirm <appname>                  # V12 lane — one release only
#   air-create build <appname>                    # V12 lane — the job builds now
#   air-create qa <appname>                       # V12 lane — Browser Run now
#   air-create test <appname> [--guest-url <url>] # V12 lane — the job checks now
#   air-create release <appname> dev [--renew|--revoke]
#   air-create status <appname|slug>
#   air-create drop <file.html|file.zip|dir> [--name <app-name>] [--title <t>]
#   air-create finalize <appname> --name <n> --description <d>
#                       [--icon <path>|--generate-icon] [--no-mirror] [--unlisted]
#   air-create publish <app-name> [--title <t>]
#   air-create fork <old> <new>
#   air-create functions <appname> [--egress <host> …] [--cap <usd>] [--db] [--kv]
#
# new     scaffolds ~/.hermes/create/<appname>/ (air.json, create.plan.md,
#         src/main.tsx, public/) and records it in ~/.hermes/create/.active.
# plan    posts the intake event plan_written; with --deliver the control
#         plane first attaches plan.md to the owner's thread (the plan is
#         never pasted into chat).
# confirm checks goal.md and air.json.tests[] (a JSON array) and posts the
#         intake event confirm; the stage becomes confirmed.
# build   asks the control plane to compile the workspace into a DRAFT
#         version; the Build Service pulls the tree, resolves the Kit, lints
#         and validates the bundle. A hard finding produces no version.
# qa      drives this Box's agent-browser over the draft (3 viewports ×
#         reduced-motion on/off), writes screenshots to .build/qa/ and posts
#         a content-free report; the control plane never runs a browser.
# test    runs the QA matrix plus air.json.tests[] (390×760, reduced motion)
#         in this Box's browser and posts the report with
#         tests {total, passed, failed_ids}; exit 1 while a test fails.
# release promotes the draft to the dev channel (link.wzrd.tech/<u>/<a>);
#         the control plane checks CR22 and answers 409 not_ready otherwise.
# status  shows draft/dev/live versions, the last build, qa_score, tests and budget.
# drop    stages a DRAFT version from an HTML file, zip, or folder.
# finalize
#         sends name, description and icon (uploaded or generated) and files
#         the production decision; exit 3 when the control plane lacks the route.
# publish files a Needs-you decision; the OWNER approves it on their phone.
#         Nothing here ever flips an app live.
# fork    copies ~/.hermes/create/<old> to <new> (without .build/), rewrites
#         appname in air.json and makes <new> the active project.
# functions
#         stages the backend declaration (egress hosts, daily inference cap,
#         database / kv) and files the miniapp_backend decision; with no
#         flags it prints the backend status. The OWNER approves; nothing here
#         enables a backend or widens what one may reach or spend.
#
# Folders are zipped with python3 -m zipfile (no `zip` binary is assumed).
set -euo pipefail

usage() {
  sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

env_value() {
  grep -m1 "^$1=" "$HOME/.hermes/.env" 2>/dev/null | cut -d= -f2- || true
}

BASE_URL="${OPENAI_BASE_URL:-$(env_value OPENAI_BASE_URL)}"
API_KEY="${OPENAI_API_KEY:-$(env_value OPENAI_API_KEY)}"
BASE="${BASE_URL%/api/gateway/v1}"
[ -n "$BASE" ] && [ -n "$API_KEY" ] || {
  echo "air-create: gateway credentials missing from ~/.hermes/.env" >&2
  exit 1
}

CREATE_ROOT="$HOME/.hermes/create"
ACTIVE_FILE="$CREATE_ROOT/.active"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BUILD_POLL_SECONDS=5
BUILD_POLL_LIMIT=60

json_string() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

json_get() {
  # json_get <json> <key> — prints the top-level value ("" for null/missing).
  python3 -c '
import json, sys
try:
    v = json.loads(sys.argv[1]).get(sys.argv[2])
except Exception:
    v = None
if v is None:
    print("")
elif isinstance(v, bool):
    print("true" if v else "false")
elif isinstance(v, (dict, list)):
    print(json.dumps(v))
else:
    print(v)
' "$1" "$2"
}

url_encode() {
  python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"
}

# V13 §8 / F10: every call carries the skill version so the control plane
# can refuse a stale Box (426 skill_update_queued) and meter the fleet.
SKILL_VERSION="${AIR_SKILL_VERSION:-5}"

api() {
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -sS -X "$method" "$BASE$path" \
      -H "Authorization: Bearer $API_KEY" \
      -H "x-air-skill: $SKILL_VERSION" \
      -H "Content-Type: application/json" \
      -d "$body" -w '\n%{http_code}'
  else
    curl -sS -X "$method" "$BASE$path" \
      -H "Authorization: Bearer $API_KEY" \
      -H "x-air-skill: $SKILL_VERSION" -w '\n%{http_code}'
  fi
}

# Print the body, exit non-zero on a non-2xx status; the body is the JSON
# error ({"error": "<one-line reason>", "findings": [...]}).
finish() {
  local response="$1"
  local status="${response##*$'\n'}"
  local body="${response%$'\n'*}"
  printf '%s\n' "$body"
  case "$status" in 2*) return 0 ;; *) return 1 ;; esac
}

check_appname() {
  case "$1" in
    "") usage ;;
    *[!a-z0-9-]*|-*|*-|*--*) echo "air-create: app name must be lowercase letters, digits and single hyphens" >&2; exit 3 ;;
  esac
  [ "${#1}" -le 32 ] || { echo "air-create: app name is longer than 32 characters" >&2; exit 3; }
}

# `.active` names the project a bare `build`/`qa`/`status` acts on (§9.5).
set_active() {
  mkdir -p "$CREATE_ROOT"
  printf '%s\n' "$1" > "$ACTIVE_FILE"
}

resolve_appname() {
  local name="${1:-}"
  if [ -z "$name" ] && [ -f "$ACTIVE_FILE" ]; then
    name="$(head -n1 "$ACTIVE_FILE" | tr -d '[:space:]')"
  fi
  [ -n "$name" ] || { echo "air-create: no app name given and ~/.hermes/create/.active is empty" >&2; exit 3; }
  check_appname "$name"
  printf '%s' "$name"
}

name_from_path() {
  local base
  base="$(basename "$1")"
  base="${base%.*}"
  base="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[0-9]+-//; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  printf '%s' "${base:0:32}"
}

cmd_new() {
  local name="" lane="vibe" title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lane) lane="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  check_appname "$name"
  case "$lane" in vibe|drop|import) ;; *) echo "air-create: --lane must be vibe, drop or import" >&2; exit 3 ;; esac
  [ -n "$title" ] || title="$name"

  local dir="$CREATE_ROOT/$name"
  if [ -e "$dir/air.json" ]; then
    echo "air-create: $dir already exists; edit it or pick another name" >&2
    exit 3
  fi
  mkdir -p "$dir/src" "$dir/public" "$dir/.build"
  python3 - "$dir/air.json" "$name" "$title" "$lane" <<'EOF'
import json, sys
path, name, title, lane = sys.argv[1:5]
with open(path, "w") as f:
    json.dump({
        "schema": "air.app.v1",
        "appname": name,
        "name": title,
        "description": "",
        "lane": lane,
        "entry": "src/main.tsx",
        "theme": "atmosphere",
        "surface": {"lite": True, "expanded": True},
        "kit": {"components": ["air"]},
        "actions": [],
        "guestActions": [],
        "functions": None,
    }, f, indent=2)
    f.write("\n")
EOF
  cat > "$dir/create.plan.md" <<EOF
# $title

## Goal
<one sentence: what the owner asked for>

## Screens / states
- 

## Kit components
- @kit/air (shell, tokens)

## Open questions
- 
EOF
  cat > "$dir/src/main.tsx" <<'EOF'
import { createRoot } from "react-dom/client";
import { cn, useLite } from "@kit/air";

function App() {
  const lite = useLite();
  return (
    <main className={cn("flex min-h-full flex-col items-center justify-center gap-3 p-4 text-center", lite && "lite")}>
      <h1 className="text-2xl text-ink">Hello, Air</h1>
      <p className="text-sm text-ink-muted">Edit src/main.tsx, then run air-create build.</p>
    </main>
  );
}

createRoot(document.getElementById("root")!).render(<App />);
EOF
  set_active "$name"
  printf '{"ok":true,"appname":%s,"lane":%s,"workspace":%s,"active":true}\n' \
    "$(json_string "$name")" "$(json_string "$lane")" "$(json_string "$dir")"
}

cmd_build() {
  note_v13
  local name
  name="$(resolve_appname "${1:-}")"
  [ -f "$CREATE_ROOT/$name/air.json" ] || {
    echo "air-create: $CREATE_ROOT/$name/air.json missing — run air-create new $name first" >&2
    exit 3
  }
  set_active "$name"
  mkdir -p "$CREATE_ROOT/$name/.build"
  local response status body
  response="$(api POST /api/create/build "{\"appname\":$(json_string "$name")}")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [ "$status" != "202" ]; then
    printf '%s\n' "$body" | tee "$CREATE_ROOT/$name/.build/build.json"
    case "$status" in 2*) return 0 ;; *) return 1 ;; esac
  fi
  # The control plane held the request as long as it could; poll the ledger.
  local build_id
  build_id="$(json_get "$body" build_id)"
  [ -n "$build_id" ] || { printf '%s\n' "$body"; return 1; }
  local i=0 state=""
  while [ "$i" -lt "$BUILD_POLL_LIMIT" ]; do
    sleep "$BUILD_POLL_SECONDS"
    i=$((i + 1))
    response="$(api GET "/api/create/status?app=$(url_encode "$name")&build=$(url_encode "$build_id")")"
    status="${response##*$'\n'}"
    body="${response%$'\n'*}"
    case "$status" in 2*) ;; *) printf '%s\n' "$body"; return 1 ;; esac
    state="$(python3 -c 'import json,sys; b=(json.loads(sys.argv[1]).get("build") or {}); print(b.get("status") or "")' "$body")"
    case "$state" in running|"") continue ;; *) break ;; esac
  done
  python3 -c '
import json, sys
s = json.loads(sys.argv[1]); b = s.get("build") or {}
out = {
  "ok": b.get("status") == "succeeded",
  "build_id": b.get("id"), "status": b.get("status") or "running",
  "slug": s.get("slug"), "appname": s.get("appname"),
  "version": b.get("version"), "preview_url": s.get("preview_url") if b.get("status") == "succeeded" else None,
  "url": s.get("url"), "findings": b.get("findings") or [], "sizes": b.get("sizes"),
  "log": b.get("log") or [], "error": b.get("error"),
}
print(json.dumps(out))
sys.exit(0 if out["ok"] else 1)
' "$body" | tee "$CREATE_ROOT/$name/.build/build.json"
}

cmd_qa() {
  note_v13
  local name
  name="$(resolve_appname "${1:-}")"
  local dir="$CREATE_ROOT/$name"
  [ -f "$dir/air.json" ] || { echo "air-create: $dir/air.json missing" >&2; exit 3; }
  command -v agent-browser >/dev/null 2>&1 || {
    echo "air-create: agent-browser is not installed in this Box" >&2
    exit 1
  }
  local response status body
  response="$(api POST /api/create/preview-link "{\"appname\":$(json_string "$name")}")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$status" in 2*) ;; *) printf '%s\n' "$body"; return 1 ;; esac
  local preview version
  preview="$(json_get "$body" preview_url)"
  version="$(json_get "$body" version)"
  [ -n "$preview" ] && [ -n "$version" ] || { echo "air-create: no draft version to QA — run air-create build first" >&2; exit 1; }

  local out_dir="$dir/.build/qa"
  rm -rf "$out_dir"
  mkdir -p "$out_dir"
  local report
  # The preview token is single-use and owner-only: it goes to the browser here and nowhere else.
  report="$(python3 "$SCRIPT_DIR/air-qa.py" "$preview" "$version" "$out_dir" --session "air-qa-$name")" || {
    echo "air-create: QA run produced no passes" >&2
    exit 1
  }
  printf '%s\n' "$report" > "$out_dir/report.json"
  response="$(api POST /api/create/qa "{\"appname\":$(json_string "$name"),\"report\":$report}")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  printf '%s\n' "$body"
  case "$status" in 2*) return 0 ;; *) return 1 ;; esac
}

cmd_drop() {
  local src="" name="" title="" desc=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      -*) usage ;;
      *) src="$1"; shift ;;
    esac
  done
  [ -n "$src" ] || usage
  src="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
  [ -e "$src" ] || { echo "air-create: no such file: $src" >&2; exit 1; }

  case "$src" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.heic|*.mov|*.mp4|*.m4v|*.webm)
      echo "air-create: that is an image or video, not a page — use /api/media/publish for a public media link" >&2
      exit 3 ;;
  esac

  local path="$src"
  if [ -d "$src" ]; then
    [ -n "$name" ] || name="$(name_from_path "$src")"
    mkdir -p "$CREATE_ROOT/.drop"
    path="$CREATE_ROOT/.drop/${name:-site}.zip"
    rm -f "$path"
    # zipfile -c <archive> <dir>/ zips the directory's contents at the root.
    (cd "$src" && python3 -m zipfile -c "$path" ./*)
  else
    case "$src" in
      *.html|*.htm|*.zip) ;;
      *) echo "air-create: drop takes one .html, one .zip, or a folder" >&2; exit 3 ;;
    esac
  fi

  local body
  body="{\"path\":$(json_string "$path")"
  [ -n "$name" ] && body="$body,\"appname\":$(json_string "$name")"
  [ -n "$title" ] && body="$body,\"name\":$(json_string "$title")"
  [ -n "$desc" ] && body="$body,\"description\":$(json_string "$desc")"
  body="$body}"
  finish "$(api POST /api/create/drop "$body")"
}

# A slug is `<username>-<appname>`, indistinguishable from an app name by
# shape, so the reference is tried as an app name first and as a slug only when
# the app lookup says not-found or not-an-app-name (a slug may run past the
# 32-character app-name cap); any other API error is reported as-is.
cmd_status() {
  local ref="${1:-}" response
  [ -n "$ref" ] || ref="$(resolve_appname "")"
  response="$(api GET "/api/create/status?app=$(url_encode "$ref")")"
  case "${response##*$'\n'}" in
    400|404) response="$(api GET "/api/create/status?slug=$(url_encode "$ref")")" ;;
  esac
  finish "$response"
}

cmd_publish() {
  local name="" title="" desc=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || usage
  # Only send metadata the agent was given: the app keeps its own title and
  # description otherwise.
  local body
  body="{\"appname\":$(json_string "$name")"
  [ -n "$title" ] && body="$body,\"name\":$(json_string "$title")"
  [ -n "$desc" ] && body="$body,\"description\":$(json_string "$desc")"
  body="$body}"
  finish "$(api POST /api/miniapps/publish "$body")"
}

cmd_functions() {
  local name="" cap="" db="" kv="" hosts="" staging=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --egress)
        [ -n "${2:-}" ] || usage
        hosts="$hosts${hosts:+,}$(json_string "$2")"; staging=1; shift 2 ;;
      --cap) cap="$2"; staging=1; shift 2 ;;
      --db) db=true; staging=1; shift ;;
      --no-db) db=false; staging=1; shift ;;
      --kv) kv=true; staging=1; shift ;;
      --no-kv) kv=false; staging=1; shift ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_appname "$name")"
  if [ "$staging" -eq 0 ]; then
    finish "$(api GET "/api/create/functions?app=$(url_encode "$name")")"
    return
  fi
  if [ -n "$cap" ]; then
    case "$cap" in
      *[!0-9.]*|""|.|*.*.*) echo "air-create: --cap takes a dollar amount, e.g. --cap 0.50" >&2; exit 3 ;;
    esac
  fi
  local body
  body="{\"app\":$(json_string "$name")"
  [ -n "$hosts" ] && body="$body,\"egress\":[$hosts]"
  [ -n "$cap" ] && body="$body,\"cap\":$cap"
  [ -n "$db" ] && body="$body,\"db\":$db"
  [ -n "$kv" ] && body="$body,\"kv\":$kv"
  body="$body}"
  finish "$(api POST /api/create/functions "$body")"
}

# --- V12: the /create intake loop (§8.1, §8.3, §8.4, §11.1) -----------------

# Split an `api` response into STATUS and BODY (globals, one call at a time).
split_response() {
  STATUS="${1##*$'\n'}"
  BODY="${1%$'\n'*}"
}

intake_event() {
  # intake_event <appname> <event> — POST /api/create/intake, state only.
  api POST /api/create/intake "{\"appname\":$(json_string "$1"),\"event\":$(json_string "$2")}"
}

cmd_plan() {
  local name="" deliver=0 answers=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --deliver) deliver=1; shift ;;
      --answers) answers="$2"; shift 2 ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_appname "$name")"
  local dir="$CREATE_ROOT/$name"
  [ -f "$dir/air.json" ] || { echo "air-create: $dir/air.json missing — run air-create new $name first" >&2; exit 3; }
  [ -s "$dir/plan.md" ] || { echo "air-create: $dir/plan.md missing or empty — write it from the plan skeleton first" >&2; exit 3; }
  [ -z "$answers" ] || [ -f "$answers" ] || { echo "air-create: --answers file not found: $answers" >&2; exit 3; }
  set_active "$name"
  local delivered="null"
  if [ "$deliver" -eq 1 ]; then
    # The control plane reads the file out of this Box (readComputeFile) and
    # attaches it to the owner's thread; the bytes never go through chat.
    split_response "$(api POST /api/create/plan/deliver \
      "{\"appname\":$(json_string "$name"),\"path\":$(json_string "~/.hermes/create/$name/plan.md")}")"
    case "$STATUS" in 2*) delivered="$BODY" ;; *) printf '%s\n' "$BODY"; return 1 ;; esac
  fi
  split_response "$(intake_event "$name" plan_written)"
  case "$STATUS" in
    2*) ;;
    # Already plan_sent (a redelivery): the attachment went out, the stage stands.
    409) [ "$deliver" -eq 1 ] || { printf '%s\n' "$BODY"; return 1; } ;;
    *) printf '%s\n' "$BODY"; return 1 ;;
  esac
  printf '{"ok":true,"appname":%s,"delivered":%s,"intake":%s}\n' "$(json_string "$name")" "$delivered" "${BODY:-null}"
}

# air.json.tests must be a JSON array of {id, …} objects (§8.4) before the
# Builder starts; prints "<total> <locked>" or fails with a one-line reason.
check_tests() {
  python3 - "$1" <<'EOF'
import json, re, sys
path = sys.argv[1]
try:
    manifest = json.load(open(path))
except Exception as exc:
    sys.stderr.write(f"air-create: {path} is not valid JSON ({exc.__class__.__name__})\n"); sys.exit(3)
tests = manifest.get("tests") if isinstance(manifest, dict) else None
if tests is None:
    sys.stderr.write(f"air-create: {path} has no \"tests\" — copy goal.md ## Tests into air.json.tests\n"); sys.exit(3)
if not isinstance(tests, list):
    sys.stderr.write(f"air-create: air.json.tests must be a JSON array, got {type(tests).__name__}\n"); sys.exit(3)
ids = set()
for i, t in enumerate(tests):
    if not isinstance(t, dict) or not isinstance(t.get("id"), str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", t["id"]):
        sys.stderr.write(f"air-create: air.json.tests[{i}] needs a string id (lowercase letters, digits, hyphens)\n"); sys.exit(3)
    if t["id"] in ids:
        sys.stderr.write(f"air-create: air.json.tests has a duplicate id: {t['id']}\n"); sys.exit(3)
    ids.add(t["id"])
print(len(tests), sum(1 for t in tests if t.get("locked") is True))
EOF
}

note_v13() {
  echo "air-create: the job does this now — air-create go <app> drives build, check and publish" >&2
}

cmd_confirm() {
  note_v13
  local name
  name="$(resolve_appname "${1:-}")"
  local dir="$CREATE_ROOT/$name"
  [ -f "$dir/air.json" ] || { echo "air-create: $dir/air.json missing" >&2; exit 3; }
  [ -s "$dir/goal.md" ] || { echo "air-create: $dir/goal.md missing or empty — write it from the goal skeleton first" >&2; exit 3; }
  local counts total locked
  counts="$(check_tests "$dir/air.json")" || exit 3
  total="${counts%% *}"
  locked="${counts##* }"
  set_active "$name"
  split_response "$(intake_event "$name" confirm)"
  case "$STATUS" in 2*) ;; *) printf '%s\n' "$BODY"; return 1 ;; esac
  printf '{"ok":true,"appname":%s,"tests_total":%s,"tests_locked":%s,"intake":%s}\n' \
    "$(json_string "$name")" "$total" "$locked" "${BODY:-null}"
}

cmd_test() {
  note_v13
  local name="" guest_url=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --guest-url) guest_url="$2"; shift 2 ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_appname "$name")"
  local dir="$CREATE_ROOT/$name"
  [ -f "$dir/air.json" ] || { echo "air-create: $dir/air.json missing" >&2; exit 3; }
  check_tests "$dir/air.json" >/dev/null || exit 3
  command -v agent-browser >/dev/null 2>&1 || {
    echo "air-create: agent-browser is not installed in this Box" >&2
    exit 1
  }
  split_response "$(api POST /api/create/preview-link "{\"appname\":$(json_string "$name")}")"
  case "$STATUS" in 2*) ;; *) printf '%s\n' "$BODY"; return 1 ;; esac
  local preview version
  preview="$(json_get "$BODY" preview_url)"
  version="$(json_get "$BODY" version)"
  [ -n "$preview" ] && [ -n "$version" ] || { echo "air-create: no draft version to test — run air-create build first" >&2; exit 1; }

  local out_dir="$dir/.build/tests"
  rm -rf "$out_dir"
  mkdir -p "$out_dir"
  local -a extra=()
  [ -z "$guest_url" ] || extra=(--guest-url "$guest_url")
  local output
  # Same runner as qa, plus the tests[] pass; the preview token goes to the browser and nowhere else.
  output="$(python3 "$SCRIPT_DIR/air-qa.py" "$preview" "$version" "$out_dir" --session "air-test-$name" \
    --tests "$dir/air.json" ${extra[@]+"${extra[@]}"})" || {
    echo "air-create: test run produced no passes" >&2
    exit 1
  }
  printf '%s\n' "$output" > "$out_dir/report.json"
  # The QA report schema is strict: `tests` rides beside it, not inside it.
  local report tests
  report="$(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); r.pop("tests", None); print(json.dumps(r))' "$output")"
  tests="$(json_get "$output" tests)"
  [ -n "$tests" ] || tests='{"total":0,"passed":0,"failed_ids":[]}'
  split_response "$(api POST /api/create/qa "{\"appname\":$(json_string "$name"),\"report\":$report,\"tests\":$tests}")"
  python3 -c '
import json, sys
body, tests = sys.argv[1], json.loads(sys.argv[2])
try:
    out = json.loads(body)
except Exception:
    out = {"raw": body}
if isinstance(out, dict) and "tests" not in out:
    out["tests"] = tests
print(json.dumps(out))
' "$BODY" "$tests"
  case "$STATUS" in 2*) ;; *) return 1 ;; esac
  [ "$(json_get "$tests" passed)" = "$(json_get "$tests" total)" ]
}

cmd_release() {
  note_v13
  local name="" channel="" action="promote"
  while [ $# -gt 0 ]; do
    case "$1" in
      --renew) action="renew"; shift ;;
      --revoke) action="revoke"; shift ;;
      -*) usage ;;
      *) if [ -z "$name" ]; then name="$1"; else channel="$1"; fi; shift ;;
    esac
  done
  [ -n "$name" ] || usage
  [ "$channel" = "dev" ] || { echo "air-create: release takes the channel 'dev' (production is the owner's decision)" >&2; exit 3; }
  check_appname "$name"
  split_response "$(api POST /api/create/release \
    "{\"appname\":$(json_string "$name"),\"channel\":\"dev\",\"action\":$(json_string "$action")}")"
  # The body carries { version, url, expires_at }; the url is what the skill repeats to the owner.
  printf '%s\n' "$BODY"
  case "$STATUS" in 2*) return 0 ;; *) return 1 ;; esac
}

# V13 §8 `go` — POST /api/create/go starts the CreateJob; the reply prints
# `reply` (the one line under the card) and `card` (the never-edited
# `[card: create <slug> job=<id>]` marker) so the turn can end right after.
# `--change` names the newest intake/changes/<n>.md the caller just wrote.
cmd_go() {
  local name="" change=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --change) change=1; shift ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_appname "$name")"
  set_active "$name"
  local kind="initial" change_file=""
  if [ "$change" -eq 1 ]; then
    kind="change"
    change_file="$(ls -1t "$CREATE_ROOT/$name/intake/changes" 2>/dev/null | head -n1 || true)"
    [ -n "$change_file" ] || { echo "air-create: no intake/changes/<n>.md — write the change file first" >&2; exit 3; }
    change_file="intake/changes/$change_file"
  fi
  local body
  body="$(python3 -c '
import json, sys
out = {"appname": sys.argv[1], "kind": sys.argv[2]}
if sys.argv[3]:
    out["change_file"] = sys.argv[3]
print(json.dumps(out))
' "$name" "$kind" "$change_file")"
  local response
  response="$(api POST /api/create/go "$body")"
  local status="${response##*$'\n'}" out="${response%$'\n'*}"
  # 426 skill_update_queued — the fleet is upgrading; print the reply so the
  # turn can still answer the owner once.
  printf '%s\n' "$out"
  case "$status" in 2*) return 0 ;; 426) return 0 ;; *) return 1 ;; esac
}

# V13 §8 `compile` — the fast syntax+lint pass code turns use for
# self-checking (≤5 per turn, enforced server-side). Prints
# {ok, findings, sizes}; ok:true means no hard findings.
cmd_compile() {
  local name
  name="$(resolve_appname "${1:-}")"
  [ -f "$CREATE_ROOT/$name/air.json" ] || {
    echo "air-create: $CREATE_ROOT/$name/air.json missing — run air-create new $name first" >&2
    exit 3
  }
  local response status body
  response="$(api POST /api/create/compile "{"appname":$(json_string "$name")}")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  printf '%s\n' "$body"
  case "$status" in
    2*) return 0 ;;
    429) echo "air-create: compile cap for this turn — fix by hand or let the job check" >&2; return 1 ;;
    *) return 1 ;;
  esac
}

cmd_finalize() {
  local name="" title="" desc="" icon="" generate=0 mirror=true store="listed"
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) title="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      --icon) icon="$2"; shift 2 ;;
      --generate-icon) generate=1; shift ;;
      --no-mirror) mirror=false; shift ;;
      --mirror) mirror=true; shift ;;
      --unlisted) store="unlisted"; shift ;;
      --listed) store="listed"; shift ;;
      -*) usage ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_appname "$name")"
  [ -n "$title" ] && [ -n "$desc" ] || { echo "air-create: finalize needs --name and --description" >&2; exit 3; }
  [ "${#title}" -le 60 ] || { echo "air-create: --name is longer than 60 characters" >&2; exit 3; }
  [ "${#desc}" -le 160 ] || { echo "air-create: --description is longer than 160 characters" >&2; exit 3; }
  [ -z "$icon" ] || [ "$generate" -eq 0 ] || { echo "air-create: pass --icon or --generate-icon, not both" >&2; exit 3; }
  local icon_key=""
  if [ -n "$icon" ] || [ "$generate" -eq 1 ]; then
    local icon_body
    if [ -n "$icon" ]; then
      icon="$(cd "$(dirname "$icon")" && pwd)/$(basename "$icon")"
      [ -f "$icon" ] || { echo "air-create: no such icon file: $icon" >&2; exit 1; }
      case "$icon" in
        *.png|*.jpg|*.jpeg|*.webp|*.heic) ;;
        *) echo "air-create: --icon takes a png, jpg, webp or heic image" >&2; exit 3 ;;
      esac
      icon_body="{\"appname\":$(json_string "$name"),\"path\":$(json_string "$icon")}"
    else
      icon_body="{\"appname\":$(json_string "$name"),\"generate\":true}"
    fi
    split_response "$(api POST /api/create/icon "$icon_body")"
    case "$STATUS" in
      2*) ;;
      404) echo "finalize is not available on this control plane yet" >&2; exit 3 ;;
      *) printf '%s\n' "$BODY"; return 1 ;;
    esac
    icon_key="$(json_get "$BODY" icon_key)"
    [ -n "$icon_key" ] || { printf '%s\n' "$BODY"; echo "air-create: the icon route returned no icon_key" >&2; return 1; }
  fi
  local body
  body="{\"app\":$(json_string "$name"),\"name\":$(json_string "$title"),\"description\":$(json_string "$desc")"
  [ -n "$icon_key" ] && body="$body,\"icon_key\":$(json_string "$icon_key")"
  body="$body,\"mirror\":$mirror,\"store\":$(json_string "$store")}"
  split_response "$(api POST /api/create/finalize "$body")"
  case "$STATUS" in
    404) echo "finalize is not available on this control plane yet" >&2; exit 3 ;;
  esac
  printf '%s\n' "$BODY"
  case "$STATUS" in 2*) return 0 ;; *) return 1 ;; esac
}

cmd_fork() {
  local old="${1:-}" new="${2:-}"
  [ -n "$old" ] && [ -n "$new" ] || usage
  check_appname "$old"
  check_appname "$new"
  local src="$CREATE_ROOT/$old" dst="$CREATE_ROOT/$new"
  [ -f "$src/air.json" ] || { echo "air-create: $src/air.json missing — nothing to fork" >&2; exit 3; }
  [ ! -e "$dst" ] || { echo "air-create: $dst already exists; pick another name" >&2; exit 3; }
  python3 - "$src" "$dst" "$new" <<'EOF'
import json, shutil, sys
src, dst, new = sys.argv[1:4]
# .build/ holds the old app's build reply, QA screenshots and tests; a fork starts clean.
shutil.copytree(src, dst, ignore=shutil.ignore_patterns(".build"), symlinks=False)
path = f"{dst}/air.json"
manifest = json.load(open(path))
manifest["appname"] = new
with open(path, "w") as f:
    json.dump(manifest, f, indent=2)
    f.write("\n")
EOF
  mkdir -p "$dst/.build"
  set_active "$new"
  printf '{"ok":true,"appname":%s,"from":%s,"workspace":%s,"active":true}\n' \
    "$(json_string "$new")" "$(json_string "$old")" "$(json_string "$dst")"
}

case "${1:-}" in
  go) shift; cmd_go "$@" ;;
  compile) shift; cmd_compile "$@" ;;
  new) shift; cmd_new "$@" ;;
  plan) shift; cmd_plan "$@" ;;
  confirm) shift; cmd_confirm "$@" ;;
  build) shift; cmd_build "$@" ;;
  qa) shift; cmd_qa "$@" ;;
  test) shift; cmd_test "$@" ;;
  release) shift; cmd_release "$@" ;;
  drop) shift; cmd_drop "$@" ;;
  status) shift; cmd_status "$@" ;;
  finalize) shift; cmd_finalize "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  fork) shift; cmd_fork "$@" ;;
  functions) shift; cmd_functions "$@" ;;
  *) usage ;;
esac
