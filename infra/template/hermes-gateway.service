[Unit]
Description=Hermes gateway (api_server on 8642)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/hermes-agent
# no-sync: an implicit `uv run` sync strips the [all] extras (aiohttp) and
# kills the api_server adapter.
Environment=UV_NO_SYNC=1
Environment=API_SERVER_HOST=0.0.0.0
Environment=API_SERVER_PORT=8642
EnvironmentFile=-/home/user/.hermes/.env
ExecStart=/home/user/.local/bin/uv run hermes gateway run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
